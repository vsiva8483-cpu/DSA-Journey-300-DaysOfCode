class Solution {
    public ArrayList<Integer> constructList(int[][] queries) {
        ArrayList<Integer> list=new ArrayList<>();
        int xorVal=0;
        list.add(0);
        for(int[] query : queries){
            int type=query[0];
            int x=query[1];
            if(type==0)
            list.add(x ^ xorVal);
            else
            xorVal ^=x;
        }
        for(int i=0; i<list.size(); i++){
            list.set(i,list.get(i) ^ xorVal);
        }
        Collections.sort(list);
        return list;
        
    }
}
